rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Hardened Global Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTableId(tableId) {
      return tableId is string
        && tableId.size() >= 14
        && tableId.size() <= 32
        && tableId.matches('^toldo-(1|2|3|5|6|7|8)-mesa-([1-9]|1[0-5])$');
    }

    function isValidToldoId(toldoId) {
      return toldoId is int && toldoId in [1, 2, 3, 5, 6, 7, 8];
    }

    function isValidTableTag(tag) {
      return tag is string && tag.size() <= 16 && tag in ['estandar', 'vip', 'familia', 'honor'];
    }

    // Validates a single family/guest entry inside a shared table's reservations list
    function isValidBookingEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['guestName', 'guestsCount', 'tag', 'notes'])
        && entry.keys().hasOnly(['guestName', 'guestsCount', 'tag', 'notes'])
        && entry.guestName is string
        && entry.guestName.size() >= 1
        && entry.guestName.size() <= 120
        && entry.guestsCount is int
        && entry.guestsCount >= 1
        && entry.guestsCount <= 10
        && isValidTableTag(entry.tag)
        && entry.notes is string
        && entry.notes.size() <= 240;
    }

    function bookingSeatsAt(bookings, idx) {
      return bookings.size() > idx ? bookings[idx].guestsCount : 0;
    }

    function sumBookingSeats(bookings) {
      return bookingSeatsAt(bookings, 0)
        + bookingSeatsAt(bookings, 1)
        + bookingSeatsAt(bookings, 2)
        + bookingSeatsAt(bookings, 3)
        + bookingSeatsAt(bookings, 4)
        + bookingSeatsAt(bookings, 5)
        + bookingSeatsAt(bookings, 6)
        + bookingSeatsAt(bookings, 7)
        + bookingSeatsAt(bookings, 8)
        + bookingSeatsAt(bookings, 9);
    }

    // Total Array Guarding across all 1..10 possible slots + exact 10-seat sum check
    function isValidReservationsList(bookings, expectedTotalSeats) {
      return bookings is list
        && bookings.size() >= 1
        && bookings.size() <= 10
        && isValidBookingEntry(bookings[0])
        && (bookings.size() < 2 || isValidBookingEntry(bookings[1]))
        && (bookings.size() < 3 || isValidBookingEntry(bookings[2]))
        && (bookings.size() < 4 || isValidBookingEntry(bookings[3]))
        && (bookings.size() < 5 || isValidBookingEntry(bookings[4]))
        && (bookings.size() < 6 || isValidBookingEntry(bookings[5]))
        && (bookings.size() < 7 || isValidBookingEntry(bookings[6]))
        && (bookings.size() < 8 || isValidBookingEntry(bookings[7]))
        && (bookings.size() < 9 || isValidBookingEntry(bookings[8]))
        && (bookings.size() < 10 || isValidBookingEntry(bookings[9]))
        && sumBookingSeats(bookings) == expectedTotalSeats;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap + Cross-Field Integrity)
    // -------------------------------------------------------------------------
    function isValidTableReservation(data, tableId) {
      return data.keys().hasAll([
          'tableId',
          'toldoId',
          'tableNumber',
          'guestName',
          'guestsCount',
          'tag',
          'notes',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'tableId',
          'toldoId',
          'tableNumber',
          'guestName',
          'guestsCount',
          'tag',
          'notes',
          'reservations',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.tableId is string
        && data.tableId == tableId
        && isValidToldoId(data.toldoId)
        && data.tableNumber is int
        && data.tableNumber >= 1
        && data.tableNumber <= 15
        && tableId == ('toldo-' + string(data.toldoId) + '-mesa-' + string(data.tableNumber))
        && data.guestName is string
        && data.guestName.size() >= 1
        && data.guestName.size() <= 200
        && data.guestsCount is int
        && data.guestsCount >= 1
        && data.guestsCount <= 10
        && isValidTableTag(data.tag)
        && data.notes is string
        && data.notes.size() <= 240
        && (!('reservations' in data) || isValidReservationsList(data.reservations, data.guestsCount))
        && data.visibility is string
        && data.visibility == 'shared'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidControlPanelConfig(data) {
      return data.keys().hasAll([
          'passwordHash',
          'passwordSalt',
          'reservationsLocked',
          'editRequiresAdmin',
          'eventNotice',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'passwordHash',
          'passwordSalt',
          'reservationsLocked',
          'editRequiresAdmin',
          'eventNotice',
          'updatedAt'
        ])
        && data.passwordHash is string
        && data.passwordHash.size() == 64
        && data.passwordHash.matches('^[a-f0-9]{64}$')
        && data.passwordSalt is string
        && data.passwordSalt.size() == 32
        && data.passwordSalt.matches('^[a-f0-9]{32}$')
        && data.reservationsLocked is bool
        && data.editRequiresAdmin is bool
        && data.eventNotice is string
        && data.eventNotice.size() <= 180
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection: /tableReservations/{tableId}
    // -------------------------------------------------------------------------
    match /tableReservations/{tableId} {
      allow get: if isValidTableId(tableId)
        && (resource == null || existing().visibility == 'shared');

      allow list: if existing().visibility == 'shared';

      allow create: if isValidTableId(tableId)
        && isValidTableReservation(incoming(), tableId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidTableId(tableId)
        && isValidTableReservation(incoming(), tableId)
        && incoming().tableId == existing().tableId
        && incoming().toldoId == existing().toldoId
        && incoming().tableNumber == existing().tableNumber
        && incoming().visibility == existing().visibility
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'guestName',
          'guestsCount',
          'tag',
          'notes',
          'reservations',
          'updatedAt'
        ]);

      allow delete: if isValidTableId(tableId)
        && existing().visibility == 'shared';
    }

    // -------------------------------------------------------------------------
    // Collection: /appConfig/{configId} (Singleton 'controlPanel')
    // -------------------------------------------------------------------------
    match /appConfig/{configId} {
      allow get: if configId is string
        && configId.size() == 12
        && configId == 'controlPanel';

      allow list: if false;

      allow create: if configId is string
        && configId.size() == 12
        && configId == 'controlPanel'
        && isValidControlPanelConfig(incoming())
        && incoming().updatedAt == request.time;

      allow update: if configId is string
        && configId.size() == 12
        && configId == 'controlPanel'
        && isValidControlPanelConfig(incoming())
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'reservationsLocked',
            'editRequiresAdmin',
            'eventNotice',
            'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'passwordHash',
            'passwordSalt',
            'updatedAt'
          ])
        );

      allow delete: if false;
    }
  }
}
